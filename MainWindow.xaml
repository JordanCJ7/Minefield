                                        <StackPanel>
                                            <TextBlock Text="⬢ 1. ZERO 50/50 GUESSING GUARANTEE" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="Every sector in the infinite grid is verified by a 3-tier deterministic logical deduction engine (Single-Cell Solvability, Subset Subtraction, and Tank Exact Set Partitioning). A mine is never placed where it would require an ambiguous guess. All safe cells can be deduced through pure logic." FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Briefing 2 -->
                                    <Border Background="#141E34" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="⬢ 2. INFINITE CHUNK PERSISTENCE &amp; STREAMING" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="The grid is infinite across both X and Y axes, divided into 16x16 chunk sectors. Sectors are asynchronously streamed from SQLite and recycled via a zero-GC memory pool. Pan and zoom without bounds; distant sectors are automatically persisted and safely unmounted." FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Briefing 3 -->
                                    <Border Background="#141E34" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="⬢ 3. CHORDING &amp; RAPID EXPEDITION" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NeonPurpleBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="Double-clicking or middle-clicking on a revealed number that has all of its adjacent mines flagged will instantly chord (reveal) all remaining adjacent hidden cells. Zero-clue empty cells automatically trigger a cross-chunk breadth-first flood-fill." FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Briefing 4 -->
                                    <Border Background="#141E34" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="⬢ 4. RECON DRONES &amp; KINETIC BLAST SHIELDS" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="#FFD600" Margin="0,0,0,4" />
                                            <TextBlock Text="Recon Drones ([1]) scan any 3x3 region with zero risk, safely revealing safe tiles and flagging mines. The Kinetic Blast Shield automatically absorbs an accidental mine detonation, saving your energy core and preserving your combo streak. Securing 16x16 sectors replenishes drone charges and shields!" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= 7. IN-GAME PAUSE MODAL OVERLAY ================= -->
                <Grid x:Name="PauseOverlayGrid" Visibility="Collapsed">
                    <Border Background="#CC070B14" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="440"
                            Background="{StaticResource BgGlassBrush}"
                            BorderBrush="{StaticResource BorderActiveBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="28,24"
                            Effect="{StaticResource PanelShadow}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="⏸ MISSION PAUSED" FontFamily="Consolas, Segoe UI" FontWeight="Black" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="GRID EXPLORATION STATE PRESERVED IN SQLITE" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />

                            <Button x:Name="BtnResumeGame" Style="{StaticResource MenuPrimaryButton}" Content="▶  RESUME EXPLORATION" Click="BtnResumeGame_Click" Margin="0,0,0,10" />
                            <Button x:Name="BtnPauseNewGame" Style="{StaticResource MenuSecondaryButton}" Content="✦  START NEW EXPEDITION" Click="BtnNewGameModal_Click" BorderBrush="{StaticResource NeonEmeraldBrush}" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,0,0,8" />
                            <Button x:Name="BtnPauseAchievements" Style="{StaticResource MenuSecondaryButton}" Content="🏆  ACHIEVEMENTS ARCHIVE" Click="BtnOpenAchievements_Click" Margin="0,0,0,8" />
                            <Button x:Name="BtnPauseProfile" Style="{StaticResource MenuSecondaryButton}" Content="👤  OPERATIVE DOSSIER" Click="BtnOpenProfile_Click" Margin="0,0,0,8" />
                            <Button x:Name="BtnPauseThemes" Style="{StaticResource MenuSecondaryButton}" Content="🎨  CHANGE THEME" Click="BtnOpenThemes_Click" Margin="0,0,0,8" />
                            <Button x:Name="BtnPauseIntel" Style="{StaticResource MenuSecondaryButton}" Content="📡  TACTICAL INTEL" Click="BtnOpenIntel_Click" Margin="0,0,0,14" />
                            <Button x:Name="BtnPauseMainMenu" Style="{StaticResource MenuSecondaryButton}" Content="🏠  RETURN TO MAIN MENU" Click="BtnPauseMainMenu_Click" Foreground="{StaticResource NeonCrimsonBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 8. FLOATING ACHIEVEMENT TOAST NOTIFICATION ================= -->
                <Border x:Name="AchievementToastBorder"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,16,0,0" Visibility="Collapsed"
                        Background="#F20A101D"
                        BorderBrush="#FFD600"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="16,10"
                        Effect="{StaticResource PanelShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#26FFD600" BorderBrush="#FFD600" BorderThickness="1.5" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtToastIcon" Text="🏆" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ACHIEVEMENT UNLOCKED: " FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="#FFA726" />
                                <TextBlock x:Name="TxtToastTitle" Text="FIRST CONTACT" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#FFD600" />
                            </StackPanel>
                            <TextBlock x:Name="TxtToastDesc" Text="Reveal your first safe sector coordinate." FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Background="#1AFFD600" BorderBrush="#33FFD600" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtToastXp" Text="+500 XP" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#FFD600" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ================= 9. NEW EXPEDITION CONFIGURATION MODAL ================= -->
                <Grid x:Name="NewGameModalGrid" Visibility="Collapsed">
                    <Border Background="#D9050810" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="680" MaxWidth="760"
                            Background="{StaticResource BgGlassBrush}"
                            BorderBrush="{StaticResource BorderActiveBrush}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="28,24"
                            Effect="{StaticResource PanelShadow}">
                        <StackPanel Orientation="Vertical">
                            <!-- Header -->
                            <TextBlock Text="✦ NEW EXPEDITION PROTOCOL CONFIGURATION" FontFamily="Consolas, Segoe UI" FontWeight="Black" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="CONFIGURE THREAT LEVEL DENSITY AND WORLD GENERATION SEED" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,0,18" />

                            <!-- Threat Level Selector Cards -->
                            <TextBlock Text="THREAT LEVEL MATRIX:" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">
                                <!-- Cadet -->
                                <Border x:Name="CardThreatCadet" MouseDown="ThreatCard_Click" Tag="Cadet" Cursor="Hand" Background="#141E34" BorderBrush="#3300E676" BorderThickness="1.5" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="CADET // LOW THREAT" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#00E676" HorizontalAlignment="Left" />
                                            <RadioButton x:Name="RbThreatCadet" IsChecked="False" GroupName="ThreatLevel" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="12% Mines • -15 Energy on Hit • 2 Shields • 1.0x XP" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Standard -->
                                <Border x:Name="CardThreatStandard" MouseDown="ThreatCard_Click" Tag="Standard" Cursor="Hand" Background="#2600E5FF" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1.5" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="STANDARD // OPERATIVE" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Left" />
                                            <RadioButton x:Name="RbThreatStandard" IsChecked="True" GroupName="ThreatLevel" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="17% Mines • -25 Energy on Hit • 1 Shield • 1.5x XP" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Hazard -->
                                <Border x:Name="CardThreatHazard" MouseDown="ThreatCard_Click" Tag="Hazard" Cursor="Hand" Background="#141E34" BorderBrush="#33FFA726" BorderThickness="1.5" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="HAZARD // HIGH RISK" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#FFA726" HorizontalAlignment="Left" />
                                            <RadioButton x:Name="RbThreatHazard" IsChecked="False" GroupName="ThreatLevel" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="22% Mines • -35 Energy on Hit • 1 Shield • 2.0x XP" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Nightmare -->
                                <Border x:Name="CardThreatNightmare" MouseDown="ThreatCard_Click" Tag="Nightmare" Cursor="Hand" Background="#141E34" BorderBrush="#33FF1744" BorderThickness="1.5" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="NIGHTMARE // HARDCORE" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#FF1744" HorizontalAlignment="Left" />
                                            <RadioButton x:Name="RbThreatNightmare" IsChecked="False" GroupName="ThreatLevel" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="28% Mines • -50 Energy on Hit • 0 Shields • 3.0x XP" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Seed Section -->
                            <TextBlock Text="WORLD GENERATION SEED:" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSeedInput" Grid.Column="0" Text="1337" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                         Background="#142036" Foreground="{StaticResource NeonCyanBrush}"
                                         BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" Padding="10,6" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                <Button x:Name="BtnRandomizeSeed" Grid.Column="1" Style="{StaticResource BackMenuButton}" Content="🎲 RANDOMIZE" Click="BtnRandomizeSeed_Click" />
                            </Grid>

                            <!-- Info Box -->
                            <Border Background="#1400E5FF" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,20">
                                <TextBlock Text="ℹ Initializing a new expedition clears previous sector terrain and starts fresh at sector [0, 0] with 100% core energy and your selected threat configuration." FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnLaunchNewExpedition" Grid.Column="0" Style="{StaticResource MenuPrimaryButton}" Content="▶  LAUNCH EXPEDITION" Click="BtnLaunchNewExpedition_Click" Margin="0,0,8,0" />
                                <Button x:Name="BtnCancelNewGame" Grid.Column="1" Style="{StaticResource BackMenuButton}" Content="✕ CANCEL" Click="BtnCancelNewGame_Click" Padding="18,10" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 10. CRITICAL CORE MELTDOWN / GAME OVER MODAL ================= -->
                <Grid x:Name="GameOverModalGrid" Visibility="Collapsed">
                    <Border Background="#E60D0507" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="520"
                            Background="{StaticResource BgGlassBrush}"
                            BorderBrush="#FF1744"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="32,26"
                            Effect="{StaticResource PanelShadow}">
                        <StackPanel Orientation="Vertical">
                            <!-- Skull / Warning Icon -->
                            <Border Width="56" Height="56" CornerRadius="28" Background="#26FF1744" BorderBrush="#FF1744" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="⚠" Foreground="#FF1744" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#FF1744" BlurRadius="16" ShadowDepth="0" Opacity="0.9" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="CRITICAL CORE FAILURE" FontFamily="Consolas, Segoe UI" FontWeight="Black" FontSize="22" Foreground="#FF1744" HorizontalAlignment="Center" />
                            <TextBlock Text="SUIT ENERGY DEPLETED // EXPEDITION TERMINATED" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,20" />

                            <!-- Run Statistics Card -->
                            <Border Background="#142036" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock Text="FINAL EXPEDITION TELEMETRY:" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="SAFE CELLS CLEARED:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtGameOverCells" Text="0" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="SECTORS SECURED:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtGameOverSectors" Text="0" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="{StaticResource NeonEmeraldBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="PEAK COMBO MULTIPLIER:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtGameOverCombo" Text="x1.0" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="#FFD600" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="EXPEDITION XP HARVESTED:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="TxtGameOverXp" Text="+0 XP" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="{StaticResource NeonPurpleBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="MINES DETONATED:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtGameOverDetonations" Text="1" FontFamily="Consolas" FontWeight="Bold" FontSize="10" Foreground="#FF5252" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <Button x:Name="BtnRebootExpedition" Style="{StaticResource MenuPrimaryButton}" Content="⟳  EMERGENCY REBOOT &amp; RESPAWN" Click="BtnRebootExpedition_Click" Margin="0,0,0,10" />
                            <Button x:Name="BtnGameOverMenu" Style="{StaticResource MenuSecondaryButton}" Content="🏠  RETURN TO MAIN MENU" Click="BtnGameOverMenu_Click" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Fullscreen Red Hazard Detonation Flash -->
                <Border x:Name="HazardFlashBorder" IsHitTestVisible="False" Opacity="0.0"
                        Background="#66FF1744" BorderBrush="#CCFF1744" BorderThickness="4" CornerRadius="10" />
            </Grid>

            <!-- ================= BOTTOM STATUS STRIP ================= -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgGlassBrush}"
                    BorderBrush="{StaticResource BorderGlassBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CORE: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="ACTIVE" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="ACTIVE THEME: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="TxtStatusTheme" Text="CYBERPUNK CYAN" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,16,0" />
                    </StackPanel>

                    <!-- Center Notification / Game Event Text -->
                    <TextBlock x:Name="TxtSectorStatus" Grid.Column="1"
                               Text="STATUS: PROTOCOL READY"
                               FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource NeonCyanBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="RENDER: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="TxtFps" Text="60.0 FPS" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="ENGINE: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="SKIASHARP IMMEDIATE" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource NeonPurpleBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
