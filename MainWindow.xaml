<Window x:Class="Minefield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:Minefield"
        mc:Ignorable="d"
        Title="MINEFIELD // INFINITE PROTOCOL"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outermost Shell Container with Glow Border and Glass Backing -->
    <Border Margin="10"
            Background="#E6080C14"
            BorderBrush="{StaticResource BorderGlassBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{StaticResource PanelShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="40" />
                <!-- Main Game / Skia Canvas Viewport Area -->
                <RowDefinition Height="*" />
                <!-- Bottom Diagnostic / Status Strip -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgGlassBrush}"
                    BorderBrush="{StaticResource BorderGlassBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <!-- Title / Logo Area -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="*" />
                        <!-- System Control Buttons -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Sci-Fi Protocol Icon -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <Border Width="22" Height="22" CornerRadius="4" Background="#1A00E5FF" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⬢" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Margin="0,-1,0,0" />
                        </Border>
                        <TextBlock Text="MINEFIELD" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="// INFINITE SECTOR GRID" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="{StaticResource NeonCyanBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8" />

                        <!-- Status Badge -->
                        <Border Background="#1400E676" BorderBrush="#3300E676" BorderThickness="1" CornerRadius="3" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource NeonEmeraldBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="ENGINE READY" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource NeonEmeraldBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Style="{StaticResource WindowActionButton}" Content="🗕" Click="BtnMinimize_Click" ToolTip="Minimize" />
                        <Button x:Name="BtnMaximize" Style="{StaticResource WindowActionButton}" Content="🗖" Click="BtnMaximize_Click" ToolTip="Maximize / Restore" Margin="4,0" />
                        <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}" Content="✕" Click="BtnClose_Click" ToolTip="Close Application" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= VIEWPORT AREA (SkiaSharp Canvas & HUD Overlay) ================= -->
            <Grid Grid.Row="1" x:Name="ViewportGrid" Background="#060910" ClipToBounds="True">
                <!-- SkiaSharp Immediate-Mode Canvas -->
                <skia:SKElement x:Name="SkiaCanvas"
                                Focusable="True"
                                PaintSurface="SkiaCanvas_PaintSurface"
                                MouseDown="SkiaCanvas_MouseDown"
                                MouseMove="SkiaCanvas_MouseMove"
                                MouseUp="SkiaCanvas_MouseUp"
                                MouseWheel="SkiaCanvas_MouseWheel"
                                MouseLeave="SkiaCanvas_MouseLeave" />

                <!-- In-Viewport Telemetry HUD Glass Card (Top Left) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="16,14"
                        Background="{StaticResource BgGlassColor}"
                        BorderBrush="{StaticResource BorderGlassBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="COORDINATES: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtWorldPos" Text="X: 0.0  Y: 0.0" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="GRID CELL:   " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtCellPos" Text="[0, 0]" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" />
                            <TextBlock Text="  SECTOR: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" />
                            <TextBlock x:Name="TxtChunkPos" Text="[0, 0]" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CAMERA ZOOM: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TxtZoom" Text="100%" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Controls Help Card (Top Right) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="16,14"
                        Background="{StaticResource BgGlassColor}"
                        BorderBrush="{StaticResource BorderGlassBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6"
                        IsHitTestVisible="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PAN: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Middle / Right Drag  " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="ZOOM: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Wheel  " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button x:Name="BtnResetCamera" Content="RESET (0,0)" FontFamily="Consolas" FontSize="9"
                                Background="#1A00E5FF" Foreground="{StaticResource NeonCyanBrush}"
                                BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1"
                                Padding="6,2" Cursor="Hand" Click="BtnResetCamera_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= BOTTOM STATUS STRIP ================= -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgGlassColor}"
                    BorderBrush="{StaticResource BorderGlassBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CORE: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="ACTIVE" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="ENGINE: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="SKIASHARP IMMEDIATE-MODE" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,16,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="RENDER: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="TxtFps" Text="60.0 FPS" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="TARGET: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="x64 STANDALONE" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource NeonPurpleBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
