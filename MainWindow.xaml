<Window x:Class="Minefield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:Minefield"
        mc:Ignorable="d"
        Title="MINEFIELD // INFINITE PROTOCOL"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outermost Shell Container with Glow Border and Glass Backing -->
    <Border Margin="10"
            Background="#E6080C14"
            BorderBrush="{StaticResource BorderGlassBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{StaticResource PanelShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="40" />
                <!-- Main Game / Skia Canvas Viewport Area -->
                <RowDefinition Height="*" />
                <!-- Bottom Diagnostic / Status Strip -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgGlassBrush}"
                    BorderBrush="{StaticResource BorderGlassBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <!-- Title / Logo Area -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="*" />
                        <!-- System Control Buttons -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Sci-Fi Protocol Icon -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <Border Width="22" Height="22" CornerRadius="4" Background="#1A00E5FF" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⬢" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Margin="0,-1,0,0" />
                        </Border>
                        <TextBlock Text="MINEFIELD" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="// INFINITE SECTOR GRID" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="{StaticResource NeonCyanBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8" />

                        <!-- Status Badge -->
                        <Border Background="#1400E676" BorderBrush="#3300E676" BorderThickness="1" CornerRadius="3" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource NeonEmeraldBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="ENGINE READY" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource NeonEmeraldBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Style="{StaticResource WindowActionButton}" Content="🗕" Click="BtnMinimize_Click" ToolTip="Minimize" />
                        <Button x:Name="BtnMaximize" Style="{StaticResource WindowActionButton}" Content="🗖" Click="BtnMaximize_Click" ToolTip="Maximize / Restore" Margin="4,0" />
                        <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}" Content="✕" Click="BtnClose_Click" ToolTip="Close Application" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= VIEWPORT AREA (Reserved for SkiaSharp Canvas & HUD) ================= -->
            <Grid Grid.Row="1" x:Name="ViewportGrid" Background="#060910">
                <Grid.Resources>
                    <!-- Ambient Background Glow -->
                    <RadialGradientBrush x:Key="AmbientGlow" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#1400E5FF" Offset="0" />
                        <GradientStop Color="#081024" Offset="0.6" />
                        <GradientStop Color="#050810" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Resources>

                <Rectangle Fill="{StaticResource AmbientGlow}" IsHitTestVisible="False" />

                <!-- Phase 1 Welcome & Verification Panel -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource BgGlassBrush}"
                        BorderBrush="{StaticResource BorderActiveBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="28,24"
                        MaxWidth="600"
                        Effect="{StaticResource CyanGlow}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="MINEFIELD PROTOCOL INITIALIZED"
                                   FontFamily="Consolas, Segoe UI"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{StaticResource NeonCyanBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Phase 1: Project Scaffolding &amp; Native Architecture Setup Complete"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />

                        <Border Background="#101C30" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="✓ .NET 9.0 WindowsDesktop Runtime" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,2" />
                                <TextBlock Text="✓ Standalone Single-File Configuration (Zero-Dependency)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,2" />
                                <TextBlock Text="✓ Borderless Glassmorphism WPF Window Shell" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,2" />
                                <TextBlock Text="✓ SkiaSharp.Views.WPF (v2.88.9) Integrated" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,2" />
                                <TextBlock Text="✓ Microsoft.EntityFrameworkCore.Sqlite (v9.0.2) Integrated" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,2" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Ready for Phase 2: SkiaSharp Rendering &amp; Infinite Camera System"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= BOTTOM STATUS STRIP ================= -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgGlassColor}"
                    BorderBrush="{StaticResource BorderGlassBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CORE: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="ACTIVE" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="SECTOR CHUNKS: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="16x16 DETERMINISTIC" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,16,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="TARGET: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="x64 STANDALONE" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource NeonPurpleBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
