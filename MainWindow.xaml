<Window x:Class="Minefield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:Minefield"
        mc:Ignorable="d"
        Title="MINEFIELD // INFINITE PROTOCOL"
        Height="780" Width="1200"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outermost Shell Container with Glow Border and Glass Backing -->
    <Border Margin="10"
            Background="#E6080C14"
            BorderBrush="{StaticResource BorderGlassBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{StaticResource PanelShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="40" />
                <!-- Main Viewport / Content Screen Area -->
                <RowDefinition Height="*" />
                <!-- Bottom Status Strip -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgGlassBrush}"
                    BorderBrush="{StaticResource BorderGlassBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <!-- Title / Logo Area -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Breadcrumb Badge -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Threat Level Badge -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="*" />
                        <!-- System Control Buttons -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Sci-Fi Protocol Icon -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <Border Width="22" Height="22" CornerRadius="4" Background="#1A00E5FF" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⬢" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Margin="0,-1,0,0" />
                        </Border>
                        <TextBlock Text="MINEFIELD" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="// INFINITE PROTOCOL" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="{StaticResource NeonCyanBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8" />
                    </StackPanel>

                    <!-- Active View Navigation Breadcrumb -->
                    <Border Grid.Column="1" Background="#1400E5FF" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" CornerRadius="3" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtViewBreadcrumb" Text="MAIN MENU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" FontFamily="Consolas, Segoe UI" />
                    </Border>

                    <!-- Threat Level Badge -->
                    <Border Grid.Column="2" x:Name="BadgeTitleThreat" Background="#1400E5FF" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitleThreat" Text="THREAT: STANDARD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" FontFamily="Consolas" />
                    </Border>

                    <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Orientation="Horizontal" Grid.Column="4" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Style="{StaticResource WindowActionButton}" Content="🗕" Click="BtnMinimize_Click" ToolTip="Minimize" />
                        <Button x:Name="BtnMaximize" Style="{StaticResource WindowActionButton}" Content="🗖" Click="BtnMaximize_Click" ToolTip="Maximize / Restore" Margin="4,0" />
                        <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}" Content="✕" Click="BtnClose_Click" ToolTip="Close Application" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= VIEWPORT & SCREENS AREA ================= -->
            <Grid Grid.Row="1" x:Name="ViewportGrid" Background="#060910" ClipToBounds="True">
                <!-- SkiaSharp Immediate-Mode Canvas (Always rendering for ambient background effect) -->
                <skia:SKElement x:Name="SkiaCanvas"
                                Focusable="True"
                                PaintSurface="SkiaCanvas_PaintSurface"
                                MouseDown="SkiaCanvas_MouseDown"
                                MouseMove="SkiaCanvas_MouseMove"
                                MouseUp="SkiaCanvas_MouseUp"
                                MouseWheel="SkiaCanvas_MouseWheel"
                                MouseLeave="SkiaCanvas_MouseLeave" />

                <!-- ================= 1. DEDICATED MAIN MENU PANEL ================= -->
                <Grid x:Name="MainMenuPanel" Visibility="Visible">
                    <Border Background="#CC070B14" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="740" MaxWidth="820"
                            Background="{StaticResource BgGlassBrush}"
                            BorderBrush="{StaticResource BorderActiveBrush}"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="36,28"
                            Effect="{StaticResource PanelShadow}">
                        <StackPanel Orientation="Vertical">
                            <!-- Hero Title Block -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <Border Width="40" Height="40" CornerRadius="8" Background="#2600E5FF" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1.5" Margin="0,0,14,0">
                                    <TextBlock Text="⬢" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Margin="0,-2,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MINEFIELD" FontFamily="Consolas, Segoe UI" FontWeight="Black" FontSize="30" Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="INFINITE PROCEDURAL RECONNAISSANCE PROTOCOL" FontFamily="Consolas, Segoe UI" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource NeonCyanBrush}" Opacity="0.9" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Guarantee Badge -->
                            <Border HorizontalAlignment="Center" Background="#1400E676" BorderBrush="#3300E676" BorderThickness="1" CornerRadius="4" Padding="10,3" Margin="0,0,0,18">
                                <TextBlock Text="ZERO 50/50 GUESSING GUARANTEE // 3-TIER DETERMINISTIC SOLVER" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" />
                            </Border>

                            <!-- Operative Quick Status Pill -->
                            <Border Background="#142036" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Operative Rank & Level -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="OPERATIVE: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtMenuRank" Text="LVL 01 [RECON SCOUT]" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderGlassBrush}" Margin="10,0" />

                                    <!-- Energy Core -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ENERGY: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtMenuEnergy" Text="100 / 100" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" />
                                    </StackPanel>

                                    <Border Grid.Column="3" Width="1" Background="{StaticResource BorderGlassBrush}" Margin="10,0" />

                                    <!-- Active Theme -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="THEME: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtMenuTheme" Text="CYBERPUNK CYAN" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Primary Action Row: Continue vs New Expedition -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnContinueGame" Grid.Column="0" Style="{StaticResource MenuPrimaryButton}" Content="▶  CONTINUE EXPEDITION" Click="BtnContinueGame_Click" Margin="0,0,6,0" />
                                <Button x:Name="BtnNewGameModal" Grid.Column="1" Style="{StaticResource MenuSecondaryButton}" Content="✦  START NEW EXPEDITION" Click="BtnNewGameModal_Click" BorderBrush="{StaticResource NeonEmeraldBrush}" Foreground="{StaticResource NeonEmeraldBrush}" Margin="6,0,0,0" />
                            </Grid>

                            <!-- Secondary Navigation Grid (2x2) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnOpenAchievements" Grid.Row="0" Grid.Column="0" Style="{StaticResource MenuSecondaryButton}" Margin="0,0,6,8" Click="BtnOpenAchievements_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏆  ACHIEVEMENTS ARCHIVE" />
                                        <Border x:Name="BadgeMenuAchievements" Background="#2600E5FF" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock x:Name="TxtMenuAchievementsCount" Text="0/12" FontSize="9" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnOpenProfile" Grid.Row="0" Grid.Column="1" Style="{StaticResource MenuSecondaryButton}" Content="👤  OPERATIVE DOSSIER" Margin="6,0,0,8" Click="BtnOpenProfile_Click" />

                                <Button x:Name="BtnOpenThemes" Grid.Row="1" Grid.Column="0" Style="{StaticResource MenuSecondaryButton}" Content="🎨  THEME MATRIX (5 THEMES)" Margin="0,0,6,0" Click="BtnOpenThemes_Click" />

                                <Button x:Name="BtnOpenIntel" Grid.Row="1" Grid.Column="1" Style="{StaticResource MenuSecondaryButton}" Content="📡  TACTICAL INTEL &amp; MANUAL" Margin="6,0,0,0" Click="BtnOpenIntel_Click" />
                            </Grid>

                            <!-- Exit Application Button -->
                            <Button x:Name="BtnExitGame" Style="{StaticResource MenuSecondaryButton}" Content="⏻  TERMINATE APPLICATION" Click="BtnExitGame_Click" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Padding="20,6" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 2. IN-GAME VIEWPORT & HUD ================= -->
                <Grid x:Name="InGameHudGrid" Visibility="Collapsed">
                    <!-- In-Viewport Telemetry HUD Glass Card (Top Left) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="16,14"
                            Background="{StaticResource BgGlassBrush}"
                            BorderBrush="{StaticResource BorderGlassBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            IsHitTestVisible="False">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="COORDINATES: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="TxtWorldPos" Text="X: 0.0  Y: 0.0" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="GRID CELL:   " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="TxtCellPos" Text="[0, 0]" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" />
                                <TextBlock Text="  SECTOR: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" />
                                <TextBlock x:Name="TxtChunkPos" Text="[0, 0]" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="CAMERA ZOOM: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="TxtZoom" Text="100%" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="STREAMING:   " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="TxtChunkCount" Text="0 SECTORS ACTIVE (SQLite)" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Controls & Pause Help Card (Top Right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="16,14"
                            Background="{StaticResource BgGlassBrush}"
                            BorderBrush="{StaticResource BorderGlassBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            IsHitTestVisible="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPauseMenu" Content="⏸ MENU [ESC]" Style="{StaticResource BackMenuButton}" Click="BtnPauseMenu_Click" Margin="0,0,10,0" />
                            <TextBlock Text="PAN: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="Drag  " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="ZOOM: " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="Wheel  " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button x:Name="BtnResetCamera" Content="RESET (0,0)" FontFamily="Consolas" FontSize="9"
                                    Background="#1A00E5FF" Foreground="{StaticResource NeonCyanBrush}"
                                    BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1"
                                    Padding="6,2" Cursor="Hand" Click="BtnResetCamera_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Top Center: Progression & Stats HUD -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,14,0,0"
                            Background="#E60A101D"
                            BorderBrush="{StaticResource BorderActiveBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,8"
                            Effect="{StaticResource PanelShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Level & Rank Badge -->
                            <Border Background="#1A00E5FF" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LVL " FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock x:Name="TxtLevel" Text="01" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                    <TextBlock x:Name="TxtHudRankTitle" Text=" [RECON SCOUT]" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- XP Bar -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Width="140">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="EXPERIENCE" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TxtXpProgress" Text="0 / 1,000" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource NeonCyanBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="7" Background="#142036" CornerRadius="3" BorderBrush="#203050" BorderThickness="1">
                                    <ProgressBar x:Name="PbXp" Value="0" Maximum="1000" Height="5" Background="Transparent" Foreground="{StaticResource NeonCyanBrush}" BorderThickness="0" Margin="1" />
                                </Border>
                            </StackPanel>

                            <!-- Energy Stamina Bar -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" Width="140">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="ENERGY CORE" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TxtEnergy" Text="100 / 100" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource NeonEmeraldBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="7" Background="#142036" CornerRadius="3" BorderBrush="#203050" BorderThickness="1">
                                    <ProgressBar x:Name="PbEnergy" Value="100" Maximum="100" Height="5" Background="Transparent" Foreground="{StaticResource NeonEmeraldBrush}" BorderThickness="0" Margin="1" />
                                </Border>
                            </StackPanel>

                            <!-- Combo Multiplier Badge -->
                            <Border x:Name="BadgeCombo" Background="#1AFFD600" BorderBrush="#88FFD600" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="COMBO " FontFamily="Consolas" FontSize="10" Foreground="#FFA726" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtCombo" Text="x1.0" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FFD600" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Targeting Banner (When Drone Active) -->
                    <Border x:Name="BannerTargeting" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,68,0,0" Visibility="Collapsed"
                            Background="#CC00E5FF" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Padding="14,4">
                        <TextBlock Text="🎯 TARGETING MODE ACTIVE: CLICK ANY CELL TO SCAN 3x3 SECTOR" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#080C14" />
                    </Border>

                    <!-- Combo Shattered Alert Banner -->
                    <Border x:Name="BannerComboShatter" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,72,0,0" Visibility="Collapsed"
                            Background="#E6FF1744" BorderBrush="#FFFFFF" BorderThickness="1.5" CornerRadius="4" Padding="14,4">
                        <TextBlock Text="⚠ COMBO SHATTERED! MULTIPLIER RESET TO x1.0 // ENERGY PENALTY INFLICTED" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                    </Border>

                    <!-- Bottom Center: Tech Tree & Ability Hotbar -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,14"
                            Background="#E60A101D"
                            BorderBrush="{StaticResource BorderGlassBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Effect="{StaticResource PanelShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Ability 1: Recon Drone -->
                            <Button x:Name="BtnDrone" Click="BtnDrone_Click" Cursor="Hand" Margin="0,0,8,0"
                                    Background="#1A00E5FF" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⯐ RECON DRONE [1] " FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}" />
                                    <Border Background="#3300E5FF" CornerRadius="3" Padding="4,1">
                                        <TextBlock x:Name="TxtDroneCharges" Text="2x" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Ability 2: Blast Shield -->
                            <Border x:Name="BadgeShield" Margin="0,0,8,0" Background="#1400E676" BorderBrush="#4400E676" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡 BLAST SHIELD [PASSIVE] " FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" />
                                    <Border Background="#3300E676" CornerRadius="3" Padding="4,1">
                                        <TextBlock x:Name="TxtShieldCharges" Text="1 CHARGE" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SFX Audio Toggle -->
                            <Button x:Name="BtnAudioToggle" Click="BtnAudioToggle_Click" Cursor="Hand"
                                    Background="#1AFFFFFF" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1"
                                    Padding="8,4">
                                <TextBlock x:Name="TxtAudioToggle" Text="🔊 SFX: ON [M]" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= 3. ACHIEVEMENTS SECTION PANEL ================= -->
                <Grid x:Name="AchievementsPanel" Visibility="Collapsed">
                    <Border Background="#E6070B14" />
                    <Border Margin="32,20"
                            Background="{StaticResource BgGlassBrush}"
                            BorderBrush="{StaticResource BorderActiveBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="24,18"
                            Effect="{StaticResource PanelShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Header -->
                                <RowDefinition Height="Auto" />
                                <!-- Category Filter Tabs -->
                                <RowDefinition Height="Auto" />
                                <!-- Scrollable Achievements Grid -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnAchievementsBack" Grid.Column="0" Style="{StaticResource BackMenuButton}" Content="← RETURN TO MENU" Click="BtnReturnToMenu_Click" Margin="0,0,16,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="🏆 TACTICAL ACHIEVEMENTS ARCHIVE" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="COMBAT MILESTONES &amp; RECONNAISSANCE HONORS" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource NeonCyanBrush}" />
                                </StackPanel>

                                <!-- Completion Badge -->
                                <Border Grid.Column="2" Background="#1400E676" BorderBrush="#3300E676" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAchievementsStats" Text="0 / 12 UNLOCKED (0%)" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource NeonEmeraldBrush}" />
                                </Border>

                                <!-- Total Trophy XP -->
                                <Border Grid.Column="3" Background="#1AFFD600" BorderBrush="#33FFD600" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAchievementsXp" Text="+0 BONUS XP" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#FFD600" />
                                </Border>
                            </Grid>

                            <!-- Filter Tabs Row -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                                <Button x:Name="BtnFilterAll" Content="ALL (12)" Style="{StaticResource BackMenuButton}" Click="BtnFilterAchievements_Click" Tag="All" Margin="0,0,6,0" />
                                <Button x:Name="BtnFilterExploration" Content="EXPLORATION" Style="{StaticResource BackMenuButton}" Click="BtnFilterAchievements_Click" Tag="Exploration" Margin="0,0,6,0" />
